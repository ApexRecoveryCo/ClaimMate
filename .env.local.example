NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only — never expose to the browser
ANTHROPIC_API_KEY=

# Optional: dense-vector policy clause retrieval (falls back to Postgres
# full-text search when unset)
VOYAGE_API_KEY=

# Optional: charge for evidence packs. All three must be set, plus the
# service role key for the webhook. Leave unset for free exports.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
